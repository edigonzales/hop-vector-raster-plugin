<pipeline>
  <info>
    <name>GeoJSON LEGACY2008 feature roundtrip</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description />
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>INPUT_VECTOR</name>
        <default_value>${Internal.Pipeline.Filename.Directory}/legacy2008.geojson</default_value>
        <description>Local input FeatureCollection</description>
      </parameter>
      <parameter>
        <name>OUTPUT_FILE</name>
        <default_value>${Internal.Pipeline.Filename.Directory}/legacy2008-result.geojson</default_value>
        <description>New output file; existing files are preserved</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/09 16:54:09.853</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/09 16:54:09.853</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read vector</from>
      <to>Encode Feature</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Encode Feature</from>
      <to>Decode Feature</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Decode Feature</from>
      <to>Write GeoJSON</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read vector</name>
    <type>SOGIS_VECTOR_READER</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <charset />
    <crsOverride />
    <fileName>${INPUT_VECTOR}</fileName>
    <format>GEOJSON</format>
    <geometryFieldName>geometry</geometryFieldName>
    <layerName />
    <timezone>UTC</timezone>
    <attributes />
    <GUI>
      <xloc>150</xloc>
      <yloc>150</yloc>
    </GUI>
    <geoJsonProfile>AUTO</geoJsonProfile>
  </transform>
  <transform>
    <name>Write GeoJSON</name>
    <type>SOGIS_VECTOR_WRITER</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <charset />
    <comma>N</comma>
    <crsOverride />
    <decimals>-1</decimals>
    <dimension>XY</dimension>
    <discardExtraOrdinates>N</discardExtraOrdinates>
    <fileName>${OUTPUT_FILE}</fileName>
    <flatGeobufIndex>Y</flatGeobufIndex>
    <flatGeobufSkipEmpty>N</flatGeobufSkipEmpty>
    <format>GEOJSON</format>
    <geometryField>decoded_geometry</geometryField>
    <geometryType>LINE</geometryType>
    <idField />
    <layerDimension>AUTO</layerDimension>
    <layerGeometryType>AUTO</layerGeometryType>
    <layerName />
    <overwrite>N</overwrite>
    <parquetAlgorithm>SPHERICAL</parquetAlgorithm>
    <parquetCompression>GZIP</parquetCompression>
    <parquetLogicalType>GEOMETRY</parquetLogicalType>
    <parquetRowGroupSize>134217728</parquetRowGroupSize>
    <shapefileFields>
</shapefileFields>
    <skipEmpty>N</skipEmpty>
    <startId>1</startId>
    <timezone>UTC</timezone>
    <attributes />
    <GUI>
      <xloc>720</xloc>
      <yloc>150</yloc>
    </GUI>
    <geoJsonProfile>LEGACY2008</geoJsonProfile>
    <geoJsonFallbackField>decoded_wgs84</geoJsonFallbackField>
    <geoJsonPropertiesField>decoded_properties</geoJsonPropertiesField>
    <geoJsonIdField>decoded_id</geoJsonIdField>
    <geoJsonContextField>geojson_context_json</geoJsonContextField>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
  <transform>
    <name>Encode Feature</name>
    <type>SOGIS_GEOJSON_FEATURE_ENCODER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <outputField>feature_json</outputField>
    <profile>LEGACY2008</profile>
    <geometryField>geometry</geometryField>
    <fallbackField>geometry_wgs84</fallbackField>
    <propertiesField>properties_json</propertiesField>
    <idField>feature_id_json</idField>
    <contextField>geojson_context_json</contextField>
    <onDataError>FAIL</onDataError>
    <GUI>
      <xloc>340</xloc>
      <yloc>150</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Decode Feature</name>
    <type>SOGIS_GEOJSON_FEATURE_DECODER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <inputField>feature_json</inputField>
    <profile>AUTO</profile>
    <geometryField>decoded_geometry</geometryField>
    <fallbackField>decoded_wgs84</fallbackField>
    <propertiesField>decoded_properties</propertiesField>
    <idField>decoded_id</idField>
    <contextField>decoded_context</contextField>
    <onDataError>FAIL</onDataError>
    <GUI>
      <xloc>530</xloc>
      <yloc>150</yloc>
    </GUI>
  </transform>
</pipeline>