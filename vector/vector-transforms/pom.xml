<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ch.so.agi</groupId>
    <artifactId>hop-vector-raster-plugin-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>hop-vector-transforms</artifactId>
  <name>Apache Hop Vector I/O</name>
  <dependencies>
<dependency><groupId>ch.so.agi</groupId><artifactId>hop-vector-format-flatgeobuf</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>ch.so.agi</groupId><artifactId>hop-vector-format-parquet</artifactId><version>${project.version}</version></dependency>

    <dependency><groupId>org.apache.hop</groupId><artifactId>hop-transform-sort</artifactId><version>${hop.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.geotools</groupId><artifactId>gt-shapefile</artifactId><scope>test</scope></dependency>
    <dependency>
      <groupId>org.geotools</groupId>
