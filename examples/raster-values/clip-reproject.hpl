<pipeline>
  <info>
    <name>Raster values: clip and reproject</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>INPUT_RASTER</name>
        <default_value>input.tif</default_value>
      </parameter>
      <parameter>
        <name>OUTPUT_RASTER</name>
        <default_value>output.tif</default_value>
      </parameter>
      <parameter>
        <name>SOURCE_CRS</name>
        <default_value>EPSG:2056</default_value>
      </parameter>
      <parameter>
        <name>TARGET_CRS</name>
        <default_value>EPSG:2056</default_value>
      </parameter>
      <parameter>
        <name>MIN_X</name>
        <default_value>2600000</default_value>
      </parameter>
      <parameter>
        <name>MIN_Y</name>
        <default_value>1200000</default_value>
      </parameter>
      <parameter>
        <name>MAX_X</name>
        <default_value>2600100</default_value>
      </parameter>
      <parameter>
        <name>MAX_Y</name>
        <default_value>1200100</default_value>
      </parameter>
      <parameter>
        <name>RESOLUTION</name>
        <default_value>1</default_value>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop>
      <from>Read</from>
      <to>Clip</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clip</from>
      <to>Reproject</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reproject</from>
      <to>Write</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read</name>
    <type>SOGIS_RASTER_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <source>${INPUT_RASTER}</source>
    <GUI>
      <xloc>120</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Clip</name>
    <type>SOGIS_RASTER_VALUE_CLIP</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <clipMethod>BOUNDING_BOX</clipMethod>
    <explicitCrs>${SOURCE_CRS}</explicitCrs>
    <minX>${MIN_X}</minX>
    <minY>${MIN_Y}</minY>
    <maxX>${MAX_X}</maxX>
    <maxY>${MAX_Y}</maxY>
    <bands>ALL</bands>
    <GUI>
      <xloc>340</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Reproject</name>
    <type>SOGIS_RASTER_VALUE_REPROJECT</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <targetCrs>${TARGET_CRS}</targetCrs>
    <resolutionX>${RESOLUTION}</resolutionX>
    <resolutionY>${RESOLUTION}</resolutionY>
    <extentMode>AUTO</extentMode>
    <interpolation>BILINEAR</interpolation>
    <outputType>AUTO</outputType>
    <GUI>
      <xloc>560</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Write</name>
    <type>SOGIS_RASTER_WRITER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <rasterField>raster</rasterField>
    <output>${OUTPUT_RASTER}</output>
    <overwrite>N</overwrite>
    <prefix>out_</prefix>
    <GUI>
      <xloc>780</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>